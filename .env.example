# Spotitube environment example — copy to .env.local and fill in. .env.local is gitignored.
# NEVER put server-only secrets (Google client secret, Supabase secret key) anywhere the browser
# can see them, and never prefix a secret with VITE_ : those are inlined into the bundle.

# --- Web dev server (Vite) ---
# Google sign-in for the web build (YouTube playlist import from the browser).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=server-side-only
# Server-side scripts only (never used by the app bundle, never commit values).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Used ONLY by local admin scripts (e.g. creating sync test users). Not shipped, not inlined.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App bundle (optional overrides; both have safe public defaults baked in) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
